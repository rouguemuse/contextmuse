{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "contextmuse.com"
        }
      ],
      "destination": "https://www.contextmuse.com/:path*",
      "permanent": true
    },
    {
      "source": "/demo-restaurant-signal-report.html",
      "destination": "/signal/sample-reports/",
      "permanent": true
    },
    {
      "source": "/creative-practice/how-to-explain-yourself-to-wolves/",
      "destination": "/creative/how-to-explain-yourself-to-wolves/",
      "permanent": true
    },
    {
      "source": "/jayme/",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/jayme/product-experience/",
      "destination": "/systems/",
      "permanent": true
    },
    {
      "source": "/creative/resource-guide/",
      "destination": "/systems/resource-guide/",
      "permanent": true
    },
    {
      "source": "/systems/signal/",
      "destination": "/signal/",
      "permanent": true
    },
    {
      "source": "/custom-tools/",
      "destination": "/custom/",
      "permanent": true
    },
    {
      "source": "/custom-builds/",
      "destination": "/custom/",
      "permanent": true
    },
    {
      "source": "/work-with-me/",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/pricing/",
      "destination": "/signal/",
      "permanent": true
    },
    {
      "source": "/websites/",
      "destination": "/custom/",
      "permanent": true
    },
    {
      "source": "/audit/",
      "destination": "/custom/?service=audit#intake",
      "permanent": true
    },
    {
      "source": "/start/",
      "destination": "/custom/#intake",
      "permanent": true
    },
    {
      "source": "/portfolio/",
      "destination": "/systems/client-builds/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/work",
      "destination": "/work/index.html"
    },
    {
      "source": "/work/",
      "destination": "/work/index.html"
    },
    {
      "source": "/build",
      "destination": "/build/index.html"
    },
    {
      "source": "/build/",
      "destination": "/build/index.html"
    },
    {
      "source": "/lab",
      "destination": "/lab/index.html"
    },
    {
      "source": "/lab/",
      "destination": "/lab/index.html"
    },
    {
      "source": "/lab/design-intelligence",
      "destination": "/lab/design-intelligence/index.html"
    },
    {
      "source": "/lab/design-intelligence/",
      "destination": "/lab/design-intelligence/index.html"
    },
    {
      "source": "/design-intelligence",
      "destination": "/design-intelligence/index.html"
    },
    {
      "source": "/design-intelligence/",
      "destination": "/design-intelligence/index.html"
    },
    {
      "source": "/method",
      "destination": "/method/index.html"
    },
    {
      "source": "/method/",
      "destination": "/method/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(evidence|records|private|legal|message-analysis|drafts|reports|dealsignal|star-gift|istar-map|tiktok-shop-roi-analyzer|twenty-minute-override|southern_smoke|sixes-and-sevens|rudyards-comedy|preview|qa_output|brand|partials|docs)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
