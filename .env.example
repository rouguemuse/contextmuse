# OpenAI API Credentials for Context & Muse Website & System Check
# Add your secret key in your local .env or Vercel Project Environment Variables.
# NEVER commit the actual secret key to Git.
OPENAI_API_KEY=

# Configurable analysis model (defaults to gpt-4o-mini for fast, cost-conscious structured synthesis)
OPENAI_AUDIT_MODEL=gpt-4o-mini

# ==============================================================================
# Centralized Lead Capture Backend (Phase 3A)
# ==============================================================================

# PostgreSQL Connection String (Neon, Supabase, Vercel Postgres, AWS RDS, etc.)
# REQUIRED FOR DURABLE PRODUCTION LEAD PERSISTENCE.
# Example: postgresql://username:password@ep-cool-flower-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Fallback alias supported by Vercel Postgres
POSTGRES_URL=

# Salt used for anonymizing visitor IP addresses for rate-limiting and privacy
LEAD_ENCRYPTION_SALT=contextmuse_lead_salt_change_me_in_production

# Notification Recipient (Defaults to jayme@contextmuse.com)
LEAD_NOTIFICATION_EMAIL=jayme@contextmuse.com

# System Outbound Email Address
SYSTEM_NOTIFICATION_FROM=leads@contextmuse.com

# Optional Secondary Email Dispatch Providers (non-blocking)
# If provided, dispatches an email notification immediately after database insertion.
RESEND_API_KEY=
# Or SendGrid:
# SENDGRID_API_KEY=
